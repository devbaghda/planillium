<Page
    x:Class="Planillium.App.Pages.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <!-- HorizontalAlignment="Left" + a Width computed in code (RootScroller_SizeChanged), not
         Center+MaxWidth — see PageLayout's own doc comment for why the alignment-based approach
         doesn't hold this column at one fixed, stable width as the task list's own height/content
         changes (2026-08-05 request, "fix width on all of the pages"). -->
    <!-- G8: blank-click focus protection (Controls/FocusShield.cs). FocusPark is first so it sits under the scroller
         and Tab from the parked state enters the page content; Transparent makes blank space hit-testable. -->
    <Grid Background="Transparent">
        <Button x:Name="FocusPark" Width="1" Height="1" Opacity="0" MinWidth="0" MinHeight="0" Padding="0"
                BorderThickness="0" IsTabStop="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"/>
        <ScrollViewer x:Name="RootScroller" Padding="28,8,28,28" SizeChanged="RootScroller_SizeChanged">
            <StackPanel x:Name="ContentColumn" HorizontalAlignment="Left" Spacing="0">
                <Grid Margin="0,8,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Today" Style="{StaticResource TitleTextBlockStyle}"/>
                    <Button Grid.Column="1" Content="Evening review" Click="Review_Click"
                            VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="Subtitle"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,16"/>

                <InfoBar x:Name="OverdueBar"
                         Severity="Warning"
                         IsOpen="False"
                         IsClosable="False"
                         Margin="0,0,0,8">
                    <InfoBar.ActionButton>
                        <Button x:Name="ReplanButton" Content="Replan all overdue…" Click="Replan_Click"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar x:Name="SaveErrorBar"
                         Severity="Error"
                         IsOpen="False"
                         IsClosable="True"
                         Title="Couldn't save that change"
                         Message="The database was briefly busy — try again in a moment."
                         Margin="0,0,0,8"/>

                <StackPanel x:Name="Sections" Spacing="0"/>
                <StackPanel x:Name="TickTickHost" Spacing="0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
